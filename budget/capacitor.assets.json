{
  "assets": {
    "source": {
      "icon": "src/assets/icon.png",
      "splash": "src/assets/splash.png"
    },
    "targets": {
      "ios": {
        "splash": {
          "light": {
            "backgroundColor": "#ffffff"
          },
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      },
      "android": {
        "icon": {
          "backgroundColor": "#000000",
          "foregroundScale": 0.7,
          "adaptive": true,
          "foreground": "src/assets/icon-foreground.png"
        },
        "splash": {
          "backgroundColor": "#000000",
          "image": "src/assets/splash.png",
          "spinnerStyle": "large",
          "spinnerColor": "#42b883"
        }
      }
    }
  }
}
